{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /*
     * Der Rezept-Kern (Mengen parsen, umrechnen, skalieren) läuft identisch im
     * Browser und in der Deno-Edge-Function. Er liegt deshalb unter
     * supabase/functions/_shared — dort, wo Supabase geteilten Code erwartet —
     * und wird hier nur unter einem kurzen Namen eingehängt.
     */
    "paths": {
      "@core/*": ["./supabase/functions/_shared/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "supabase/functions/_shared"]
}
